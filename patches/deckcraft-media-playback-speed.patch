+    #[test]
+    fn playback_speed_moves_media_clock_at_selected_rate() {
+        let mut player = Player::new(None);
+        let bytes = Arc::new(Vec::new());
+        player.play(1, 1, &bytes, spec(8.0, false), Some(0.0));
+        player.set_speed(1, 2.0);
+        player.tick(0.0);
+        player.tick(0.2);
+        let fast = player.status(1).map(|status| status.position).unwrap_or_default();
+        assert!((fast - 0.4).abs() < 0.001, "{fast}");
+        player.set_speed(1, 0.5);
+        player.tick(0.4);
+        let slow = player.status(1).map(|status| status.position).unwrap_or_default();
+        assert!((slow - 0.5).abs() < 0.001, "{slow}");
+    }

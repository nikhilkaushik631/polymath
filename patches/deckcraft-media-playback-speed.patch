+    /// Set playback rate for a voice. The media clock and audio samples advance
+    /// together, keeping video in sync with audio at the selected rate.
+    /// This changes pitch; it does not perform time stretching.
+    pub fn set_speed(&mut self, key: u64, speed: f64) {
+        if !speed.is_finite() || !(0.25..=4.0).contains(&speed) {
+            return;
+        }
+        self.with(|m| {
+            if let Some(voice) = m.voices.iter_mut().find(|voice| voice.key == key) {
+                voice.speed = speed;
+            }
+        });
+    }
+
